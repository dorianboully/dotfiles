[ -f "${ZDOTDIR}/completionrc" ] && source "${ZDOTDIR}/completionrc"
[ -f "${ZDOTDIR}/optionsrc" ] && source "${ZDOTDIR}/optionsrc"
[ -f "${ZDOTDIR}/historyrc" ] && source "${ZDOTDIR}/historyrc"
[ -f "${ZDOTDIR}/aliasesrc" ] && source "${ZDOTDIR}/aliasesrc"
[ -f "${ZDOTDIR}/keybindingsrc" ] && source "${ZDOTDIR}/keybindingsrc"
[ -f "${ZDOTDIR}/themerc" ] && source "${ZDOTDIR}/themerc"
[ -f "${ZDOTDIR}/pluginsrc" ] && source "${ZDOTDIR}/pluginsrc"
# Load Bob's environment from its native location, then the XDG fallback.
for bob_env in \
  "$HOME/Library/Application Support/bob/env/env.sh" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/bob/env/env.sh"; do
  if [[ -r "$bob_env" ]]; then
    source "$bob_env"
    break
  fi
done
unset bob_env

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
